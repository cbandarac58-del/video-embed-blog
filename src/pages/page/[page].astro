---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdContainer from '../../components/AdContainer.astro';
import VideoCard from '../../components/VideoCard.astro';

export async function getStaticPaths() {
  const allVideos = (await getCollection('videos')).filter(v => v.data && v.data.category && v.data.category.toLowerCase() !== 'yt romance');
  const sortedVideos = allVideos.sort((a, b) => new Date(b.data?.dateAdded || 0).getTime() - new Date(a.data?.dateAdded || 0).getTime());
  
  const categories = [...new Set(sortedVideos.map(v => v.data.category))].filter(Boolean);
  const allTags = [...new Set(sortedVideos.flatMap(v => v.data?.tags || []))].filter(Boolean).slice(0, 15);
  
  const VIDEOS_PER_PAGE = 40;
  const totalPages = Math.ceil(sortedVideos.length / VIDEOS_PER_PAGE);
  const paths = [];
  
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: p.toString() },
      props: {
        sortedVideos,
        categories,
        allTags,
        totalPages
      }
    });
  }
  return paths;
}

const { page } = Astro.params;
const { sortedVideos, categories, allTags, totalPages } = Astro.props;
const currentPage = parseInt(page || '1', 10);

const activeCategory = '';
const sortBy = 'dateAdded';

const VIDEOS_PER_PAGE = 40;

const start = (currentPage - 1) * VIDEOS_PER_PAGE;
const pageVideos = sortedVideos.slice(start, start + VIDEOS_PER_PAGE);
const totalFilteredPages = totalPages;
const filteredVideos = sortedVideos;

// Format views
function formatViews(val: string | number) {
  if (typeof val === 'string') return val;
  if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
  if (val >= 1000) return (val / 1000).toFixed(0) + 'K';
  return val.toString();
}

function getCardGradient(slug: string) {
  const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const gradients = [
    'from-rose-600/20 to-purple-600/10',
    'from-purple-600/20 to-indigo-600/10',
    'from-pink-600/20 to-rose-600/10',
    'from-indigo-600/20 to-violet-600/10',
    'from-amber-600/20 to-rose-600/10',
  ];
  return gradients[hash % gradients.length];
}

// Build pagination URL helper
function pageUrl(p: number) {
  if (p === 1) return '/';
  return `/page/${p}`;
}

// Smart Pagination Range Generator
function getPaginationRange(current: number, total: number) {
  const delta = 1;
  const range: (number | string)[] = [];

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    } else if (range[range.length - 1] !== '...') {
      range.push('...');
    }
  }
  return range;
}

const paginationRange = getPaginationRange(currentPage, totalFilteredPages);
---

<Layout title={`Page ${currentPage} — Free Adult Videos, XXX Clips & Desi Porn`}>

  <!-- Hero Banner -->
  <section class="relative overflow-hidden bg-slate-950 py-10 border-b border-slate-900">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-rose-950/20 via-slate-950 to-slate-950"></div>
    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        Watch Free HD <span class="bg-gradient-to-r from-rose-500 via-pink-500 to-amber-500 bg-clip-text text-transparent">Porn & XXX Videos</span>
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-sm text-slate-400">
        Page {currentPage} of {totalFilteredPages} — {filteredVideos.length} total videos
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Category Filter -->
    <div class="mb-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-3">Categories</h2>
      <div class="flex space-x-2 overflow-x-auto pb-2 scrollbar-none">
        <a href={pageUrl(1)} class={`rounded-full px-4 py-1.5 text-xs font-semibold whitespace-nowrap border transition-all ${!activeCategory ? 'bg-rose-600 border-rose-500 text-white' : 'bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-700'}`}>All Videos</a>
        {categories.map((category) => {
          const catSlug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
          return (
            <a 
              href={`/category/${catSlug}`}
              class="rounded-full px-4 py-1.5 text-xs font-semibold whitespace-nowrap border bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-700 transition-all"
            >
              {category}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Sort + Status bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-t border-slate-900 pt-6 mb-8 gap-4">
      <div class="text-sm text-slate-400">
        Showing <span class="text-rose-400 font-medium">{pageVideos.length}</span> of <span class="text-rose-400 font-medium">{filteredVideos.length}</span> videos — Page <span class="text-white font-bold">{currentPage}</span>/{totalFilteredPages}
      </div>
      <div class="flex items-center space-x-2">
        <span class="text-xs text-slate-500 font-medium">Sort By:</span>
        <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-800 text-xs">
          <a href={currentPage === 1 ? '/' : `/page/${currentPage}`} class="rounded-md px-3 py-1 font-medium transition-colors bg-slate-800 text-white">Recent</a>
          <a href={currentPage === 1 ? '/popular' : `/popular/${currentPage}`} class="rounded-md px-3 py-1 font-medium transition-colors text-slate-400 hover:text-slate-200">Most Viewed</a>
          <a href={currentPage === 1 ? '/featured' : `/featured/${currentPage}`} class="rounded-md px-3 py-1 font-medium transition-colors text-slate-400 hover:text-slate-200">Top Rated</a>
        </div>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {pageVideos.map((video) => (
        <VideoCard video={video} />
      ))}
    </div>

    <!-- Numbered Pagination Controls -->
    {totalFilteredPages > 1 && (
      <div id="pagination-container" class="mt-12 flex flex-col items-center justify-center gap-4">
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
          
          <!-- Prev Button -->
          {currentPage > 1 ? (
            <a
              href={pageUrl(currentPage - 1)}
              class="flex items-center justify-center rounded-xl border border-slate-800 bg-slate-900/80 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:border-rose-500 hover:text-white transition-all"
            >
              &larr; Prev
            </a>
          ) : (
            <span class="flex items-center justify-center rounded-xl border border-slate-900 bg-slate-950 px-3.5 py-2 text-xs font-semibold text-slate-600 cursor-not-allowed opacity-50">
              &larr; Prev
            </span>
          )}

          <!-- Page Numbers Range -->
          {paginationRange.map((item) => {
            if (item === '...') {
              return <span class="px-2 text-xs font-bold text-slate-500">...</span>;
            }

            const pageNum = item as number;
            const isCurrent = pageNum === currentPage;

            return (
              <a
                href={pageUrl(pageNum)}
                class={`flex h-9 w-9 items-center justify-center rounded-xl border text-xs font-bold transition-all ${
                  isCurrent
                    ? 'border-rose-500 bg-rose-600 text-white shadow-lg shadow-rose-950/50'
                    : 'border-slate-800 bg-slate-900/80 text-slate-300 hover:border-slate-700 hover:text-white'
                }`}
              >
                {pageNum}
              </a>
            );
          })}

          <!-- Next Button -->
          {currentPage < totalFilteredPages ? (
            <a
              href={pageUrl(currentPage + 1)}
              class="flex items-center justify-center rounded-xl border border-rose-600 bg-rose-600 px-3.5 py-2 text-xs font-bold text-white shadow-lg shadow-rose-950/50 hover:bg-rose-500 transition-all"
            >
              Next &rarr;
            </a>
          ) : (
            <span class="flex items-center justify-center rounded-xl border border-slate-900 bg-slate-950 px-3.5 py-2 text-xs font-semibold text-slate-600 cursor-not-allowed opacity-50">
              Next &rarr;
            </span>
          )}
        </div>

        <!-- Page Indicator Info -->
        <div class="text-xs text-slate-500">
          Page <span class="font-bold text-slate-300">{currentPage}</span> of <span class="font-bold text-slate-300">{totalFilteredPages}</span>
        </div>
      </div>
    )}

    <!-- Tag Cloud -->
    <div class="mt-16 border-t border-slate-900 pt-8">
      <h3 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-4">Trending Tags</h3>
      <div class="flex flex-wrap gap-2">
        {allTags.map(tag => {
          const tagSlug = tag.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
          return (
            <a 
              href={`/tag/${tagSlug}`} 
              class="text-xs rounded-lg border px-3 py-1 transition-all bg-slate-950 border-slate-900 text-slate-400 hover:border-slate-800 hover:text-slate-200"
            >
              #{tag}
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
