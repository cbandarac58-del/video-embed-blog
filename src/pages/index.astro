    <!-- Mobile Categories Horizontal Scroll -->
    <div class="mb-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-3">Categories</h2>
      <div class="flex flex-wrap gap-2">
        <a 
