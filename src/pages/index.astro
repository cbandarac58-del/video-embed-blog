---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AdContainer from '../components/AdContainer.astro';
import VideoCard from '../components/VideoCard.astro';

// Get query parameters for filtering and sorting
const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get('category') || '';
const activeTag = url.searchParams.get('tag') || '';
const searchQuery = url.searchParams.get('search') || '';
const sortBy = url.searchParams.get('sort') || 'dateAdded'; // 'dateAdded' or 'views' or 'rating'

const VIDEOS_PER_PAGE = 40;

// Fetch videos collection
let videos = [];
try {
  videos = await getCollection('videos');
} catch (e) {
  console.log("No videos found in content layer yet.", e);
}

// Extract unique categories and tags for filter UI
const categories = [...new Set(videos.map(v => v.data.category))].filter(Boolean).sort((a, b) => {
  if (a === 'Indian') return -1;
  if (b === 'Indian') return 1;
  return a.localeCompare(b);
});
const allTags = [...new Set(videos.flatMap(v => v.data.tags))].filter(Boolean).slice(0, 15);

// Apply filters
let filteredVideos = [...videos];

if (activeCategory) {
  filteredVideos = filteredVideos.filter(v => v.data.category.toLowerCase() === activeCategory.toLowerCase());
}

if (activeTag) {
  filteredVideos = filteredVideos.filter(v => v.data.tags.some(t => t.toLowerCase() === activeTag.toLowerCase()));
}

if (searchQuery) {
  const query = searchQuery.toLowerCase();
  filteredVideos = filteredVideos.filter(v => 
    v.data.title.toLowerCase().includes(query) || 
    v.data.category.toLowerCase().includes(query) ||
    v.data.tags.some(t => t.toLowerCase().includes(query))
  );
}

// Parse views into numeric values for reliable sorting
function parseViews(v: string | number): number {
  if (typeof v === 'number') return v;
  const clean = v.trim().toLowerCase();
  const num = parseFloat(clean);
  if (clean.includes('m')) return num * 1000000;
  if (clean.includes('k')) return num * 1000;
  return num || 0;
}

// Apply sorting
filteredVideos.sort((a, b) => {
  if (sortBy === 'views') {
    return parseViews(b.data.views) - parseViews(a.data.views);
  } else if (sortBy === 'rating') {
    return b.data.rating - a.data.rating;
  } else {
    // Default: Sort by dateAdded descending
    return new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime();
  }
});

// Pagination — page 1 only on index
const isDefaultHome = !activeCategory && !activeTag && !searchQuery;
const totalVideos = filteredVideos.length;
const totalPages = Math.ceil(totalVideos / VIDEOS_PER_PAGE);
const pagedVideos = filteredVideos.slice(0, isDefaultHome ? 120 : VIDEOS_PER_PAGE);

// Format numbers or return strings for views
function formatViews(val: string | number) {
  if (typeof val === 'string') return val;
  if (val >= 1000000) {
    return (val / 1000000).toFixed(1) + 'M';
  }
  if (val >= 1000) {
    return (val / 1000).toFixed(0) + 'K';
  }
  return val.toString();
}

// Generate procedural styling for card gradients based on slugs to ensure consistent premium design
function getCardGradient(slug: string) {
  const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const gradients = [
    'from-rose-600/20 to-purple-600/10 hover:from-rose-500/30 hover:to-purple-500/20',
    'from-purple-600/20 to-indigo-600/10 hover:from-purple-500/30 hover:to-indigo-500/20',
    'from-pink-600/20 to-rose-600/10 hover:from-pink-500/30 hover:to-rose-500/20',
    'from-indigo-600/20 to-violet-600/10 hover:from-indigo-500/30 hover:to-violet-500/20',
    'from-amber-600/20 to-rose-600/10 hover:from-amber-500/30 hover:to-rose-500/20',
  ];
  return gradients[hash % gradients.length];
}
---

<Layout title="Watch Free Adult Videos, XXX Clips & Desi Porn">
  
  <!-- Hero / Dashboard Banner -->
  <section class="relative overflow-hidden bg-slate-950 py-12 border-b border-slate-900">
