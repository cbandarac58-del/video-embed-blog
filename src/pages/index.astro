      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm sm:text-base text-slate-400">
        Discover the highest-rated amateur, desi bhabhi, stepsister, and hardcore streaming adult videos. Clean, responsive embeds optimized for all mobile devices.
      </p>
      

    </div>
  </section>

  <!-- Filter & Listing Section -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- Leaderboard Ad Banner -->
