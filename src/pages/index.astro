---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AdContainer from '../components/AdContainer.astro';
import VideoCard from '../components/VideoCard.astro';

const VIDEOS_PER_PAGE = 40;
const HOME_CARD_COUNT = 40;

// Fetch videos collection
let videos = [];
try {
  videos = await getCollection('videos');
} catch (e) {
  console.log("No videos found in content layer yet.", e);
}

// Case-insensitive Category Map
const categoryMap = new Map<string, string>();
videos.forEach(v => {
  if (v.data && v.data.category) {
    const lower = v.data.category.toLowerCase();
    if (!categoryMap.has(lower)) {
      const formattedName = v.data.category.charAt(0).toUpperCase() + v.data.category.slice(1);
      categoryMap.set(lower, formattedName);
    }
  }
});

const categories = Array.from(categoryMap.values()).sort((a, b) => {
  if (a === 'Indian') return -1;
  if (b === 'Indian') return 1;
  return a.localeCompare(b);
});

const allTags = [...new Set(videos.flatMap(v => v.data?.tags || []))].filter(Boolean).slice(0, 15);

// Homepage always shows the default "All Trending" view (no category/tag/search here —
// filtering by category/tag lives on /category/[slug] and /tag/[slug] pages).
let filteredVideos = videos.filter(v => v.data?.category?.toLowerCase() !== 'yt romance');

// Default sort: most recent first
filteredVideos.sort((a, b) => new Date(b.data?.dateAdded || 0).getTime() - new Date(a.data?.dateAdded || 0).getTime());

const totalVideos = filteredVideos.length;
const totalPages = Math.ceil(totalVideos / VIDEOS_PER_PAGE);

// Homepage now shows a real, stable first page (40 videos) —
// no more localStorage-based rotation. Googlebot and every visitor
// see the same content, and all 13,000+ videos stay discoverable
// through consistent pagination (/page/2, /page/3, ...).
const pagedVideos = filteredVideos.slice(0, HOME_CARD_COUNT);

// FIXED: now parses numeric-looking strings (e.g. "15000") into "15K"
// instead of just returning the raw string as-is.
function formatViews(val: string | number) {
  if (!val) return '0';
  let num: number;
  if (typeof val === 'string') {
    const cleaned = val.trim().toLowerCase();
    if (cleaned.endsWith('m')) return val; // already formatted like "1.5M"
    if (cleaned.endsWith('k')) return val; // already formatted like "15K"
    num = parseFloat(cleaned);
    if (isNaN(num)) return val; // not a number at all, just show as-is
  } else {
    num = val;
  }
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(0) + 'K';
  return num.toString();
}

// Helper function to build page number sequence with ellipsis (1, 2, 3 ... 300)
function getPaginationRange(current: number, total: number) {
  const delta = 1;
  const range: (number | string)[] = [];

  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    } else if (range[range.length - 1] !== '...') {
      range.push('...');
    }
  }
  return range;
}

const paginationRange = getPaginationRange(1, totalPages);
---

<Layout title="Watch Free Adult Videos, XXX Clips & Desi Porn">
  
  <section class="relative overflow-hidden bg-slate-950 py-12 border-b border-slate-900">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-rose-950/20 via-slate-950 to-slate-950"></div>
    <div class="relative mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Watch Free HD <span class="bg-gradient-to-r from-rose-500 via-pink-500 to-amber-500 bg-clip-text text-transparent">Porn & XXX Videos</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm sm:text-base text-slate-400">
        Discover the highest-rated amateur, desi bhabhi, stepsister, and hardcore streaming adult videos. Clean, responsive embeds optimized for all mobile devices.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    
    <AdContainer slotType="banner_728x90" className="mb-6" />

    <div class="mb-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Categories</h2>
      <div class="flex flex-wrap gap-2">
        <a 
          href="/" 
          class="rounded-full px-4 py-2 text-xs font-semibold whitespace-nowrap border min-h-[44px] inline-flex items-center transition-all bg-rose-600 border-rose-500 text-white shadow-lg shadow-rose-600/20"
        >
          All Videos
        </a>
        {categories.map((category) => {
          const catSlug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
          return (
            <a 
              href={`/category/${catSlug}`}
              class="rounded-full px-4 py-2 text-xs font-semibold whitespace-nowrap border bg-slate-900 border-slate-800 text-slate-300 hover:border-slate-700 min-h-[44px] inline-flex items-center transition-all"
            >
              {category}
            </a>
          );
        })}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-t border-slate-900 pt-6 mb-8 gap-4">
      <div id="filter-status-text" class="text-sm text-slate-400">
        <span>Showing <span class="text-rose-400 font-medium">All Trending</span> Videos</span>
        <span class="text-xs text-slate-400 ml-1">({filteredVideos.length} items)</span>
      </div>

      <div class="flex items-center space-x-2">
        <span class="text-xs text-slate-400 font-medium">Sort By:</span>
        <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-800 text-xs">
          <a href="/" class="rounded-md px-3 py-1.5 font-medium transition-colors bg-slate-800 text-white min-h-[40px] inline-flex items-center">Recent</a>
          <a href="/popular" class="rounded-md px-3 py-1.5 font-medium transition-colors text-slate-400 hover:text-slate-200 min-h-[40px] inline-flex items-center">Most Viewed</a>
          <a href="/featured" class="rounded-md px-3 py-1.5 font-medium transition-colors text-slate-400 hover:text-slate-200 min-h-[40px] inline-flex items-center">Top Rated</a>
        </div>
      </div>
    </div>

    {filteredVideos.length === 0 ? (
      <div class="flex flex-col items-center justify-center rounded-2xl border border-dashed border-slate-800 py-20 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-900 text-rose-500 border border-slate-800 mb-4 animate-bounce">✦</div>
        <h3 class="text-lg font-bold text-slate-200">No Videos Found</h3>
      </div>
    ) : (
      <div id="video-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {pagedVideos.map((video, idx) => (
          <VideoCard 
            video={video} 
            loading={idx < 4 ? "eager" : "lazy"} 
            fetchpriority={idx < 4 ? "high" : "auto"} 
          />
        ))}
      </div>
    )}

    <!-- Numbered Pagination Container -->
    {totalPages > 1 && (
      <div id="pagination-container" class="mt-12 flex flex-col items-center justify-center gap-4">
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
          
          <!-- Prev Button -->
          <span class="flex items-center justify-center rounded-xl border border-slate-900 bg-slate-950 px-3.5 py-2 text-xs font-semibold text-slate-600 cursor-not-allowed opacity-50">
            &larr; Prev
          </span>

          <!-- Page Numbers Range (1, 2, 3 ... TotalPages) -->
          {paginationRange.map((item) => {
            if (item === '...') {
              return <span class="px-2 text-xs font-bold text-slate-500">...</span>;
            }

            const pageNum = item as number;
            const isCurrent = pageNum === 1;
            const targetUrl = pageNum === 1 ? '/' : `/page/${pageNum}`;

            return (
              <a
                href={targetUrl}
                class={`flex h-9 w-9 items-center justify-center rounded-xl border text-xs font-bold transition-all ${
                  isCurrent
                    ? 'border-rose-500 bg-rose-600 text-white shadow-lg shadow-rose-950/50'
                    : 'border-slate-800 bg-slate-900/80 text-slate-300 hover:border-slate-700 hover:text-white'
                }`}
              >
                {pageNum}
              </a>
            );
          })}

          <!-- Next Button -->
          <a
            href="/page/2"
            class="flex items-center justify-center rounded-xl border border-rose-600 bg-rose-600 px-3.5 py-2 text-xs font-bold text-white shadow-lg shadow-rose-950/50 hover:bg-rose-500 transition-all"
          >
            Next &rarr;
          </a>
        </div>

        <!-- Page Indicator Info -->
        <div class="text-xs text-slate-500">
          Page <span class="font-bold text-slate-300">1</span> of <span class="font-bold text-slate-300">{totalPages}</span>
        </div>
      </div>
    )}

    <div class="mt-16 border-t border-slate-900 pt-8">
      <h3 class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-4">Trending Tags</h3>
      <div class="flex flex-wrap gap-2">
        {allTags.map(tag => {
          const tagSlug = tag.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '').replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
          return (
            <a href={`/tag/${tagSlug}`} class="text-xs rounded-lg border px-3 py-1 transition-all bg-slate-950 border-slate-900 text-slate-400 hover:border-slate-800 hover:text-slate-200">
              #{tag}
            </a>
          );
        })}
      </div>
    </div>
    
    <!-- Instant Search Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const searchInputs = document.querySelectorAll('input[name="search"]');
        const videoGrid = document.querySelector('#video-grid');
        const paginationContainer = document.querySelector('#pagination-container');
        const filterStatus = document.querySelector('#filter-status-text');

        let videosData = [];

        // FIXED: escapes any HTML in a string before it's ever inserted into
        // the page, so a malicious/broken title or category (e.g. containing
        // <script> or " onerror=) can't execute as code (XSS).
        function escapeHtml(str) {
          if (str === null || str === undefined) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        fetch('/videos.json')
          .then(res => res.json())
          .then(data => {
            videosData = data;
            const params = new URLSearchParams(window.location.search);
            const searchParam = params.get('search');
            if (searchParam) {
              searchInputs.forEach(input => input.value = searchParam);
              performSearch(searchParam);
            }
          })
          .catch(err => console.error('Error fetching search index:', err));

        searchInputs.forEach(input => {
          const form = input.closest('form');
          if (form) {
            form.addEventListener('submit', (e) => {
              e.preventDefault();
              performSearch(input.value);
            });
          }

          input.addEventListener('input', (e) => {
            performSearch(e.target.value);
          });
        });

        function performSearch(query) {
          const cleanQuery = query.trim().toLowerCase();
          
          if (!cleanQuery) {
            window.location.reload();
            return;
          }

          const results = videosData.filter(v => 
            (v.title && v.title.toLowerCase().includes(cleanQuery)) || 
            (v.category && v.category.toLowerCase().includes(cleanQuery)) ||
            (v.tags && v.tags.some(t => t.toLowerCase().includes(cleanQuery)))
          );

          if (paginationContainer) paginationContainer.classList.add('hidden');
          // FIXED: query is now escaped before being placed into innerHTML
          if (filterStatus) filterStatus.innerHTML = `Search results for "<span class="text-rose-400 font-medium">${escapeHtml(query)}</span>" (${results.length} items)`;

          renderVideos(results);
        }

        function renderVideos(items) {
          if (!videoGrid) return;
          // FIXED: title, category, and thumbnailUrl are all escaped before
          // being inserted into innerHTML — previously these came straight
          // from database.json with no sanitization.
          videoGrid.innerHTML = items.map(item => {
            const safeTitle = escapeHtml(item.title);
            const safeCategory = escapeHtml(item.category);
            const safeSlug = escapeHtml(item.slug);
            const safeThumb = item.thumbnailUrl ? escapeHtml(item.thumbnailUrl) : '';
            return `
            <a href="/videos/${safeSlug}" class="group relative flex flex-col rounded-2xl overflow-hidden border border-slate-900 bg-slate-950/40 backdrop-blur-sm transition-all duration-300 hover:border-rose-500/30 hover:-translate-y-1">
              <div class="relative aspect-video w-full overflow-hidden flex items-center justify-center bg-slate-950">
                ${safeThumb ? `<img src="${safeThumb}" referrerpolicy="no-referrer" alt="${safeTitle}" loading="lazy" class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />` : ''}
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-slate-950/30"></div>
                <span class="absolute bottom-3 right-3 z-10 rounded-md bg-gradient-to-r from-rose-600 to-pink-600 px-2.5 py-0.5 text-[9px] font-extrabold uppercase tracking-wider text-white">${safeCategory}</span>
              </div>
              <div class="flex flex-col flex-1 p-4 bg-slate-950/20">
                <h3 class="text-sm font-bold text-slate-200 line-clamp-2 group-hover:text-rose-400 transition-colors min-h-[40px] leading-snug">${safeTitle}</h3>
              </div>
            </a>
          `;
          }).join('');
        }
      });
    </script>
  </section>
</Layout>
