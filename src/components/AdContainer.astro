---
interface Props {
  slotType: 'banner_728x90' | 'banner_300x250' | 'banner_468x60';
  className?: string;
}

const { slotType, className = "" } = Astro.props;

// Define specific styles and placeholder sizing to reserve exact space (preventing CLS)
const slotConfigs = {
  banner_728x90: {
    dimensions: "w-full max-w-[728px] h-[90px]",
    label: "Leaderboard Banner (728x90)",
    scriptPlaceholder: "/* Adsterra 728x90 Script */",
    hint: "Optimal for desktop headers & video player tops"
  },
  banner_300x250: {
    dimensions: "w-[300px] h-[250px]",
    label: "Medium Rectangle (300x250)",
    scriptPlaceholder: "/* Adsterra 300x250 Script */",
    hint: "Optimal for sidebars & related grids"
  },
  banner_468x60: {
    dimensions: "w-full max-w-[468px] h-[60px]",
    label: "Mobile Banner (468x60)",
    scriptPlaceholder: "/* Adsterra 468x60 Script */",
    hint: "Optimal for mobile device screens"
  }
};

const config = slotConfigs[slotType];
---

<div class={`flex flex-col items-center justify-center my-6 mx-auto ${className}`}>
  <!-- Label indicating sponsored content -->
  <span class="text-[9px] uppercase tracking-widest text-slate-600 mb-1">Sponsored Content</span>
  
  <!-- The actual CLS-free Ad Container -->
  <div 
    class={`relative flex items-center justify-center border border-slate-900 bg-slate-950 rounded-md overflow-hidden transition-all shadow-inner ${config.dimensions}`}
  >
    <!-- Background pulse state acting as a skeleton loader -->
    <div class="absolute inset-0 -z-10 bg-slate-900/40 animate-pulse"></div>

    <!-- Ad placeholder text (hidden when script injects ad elements) -->
    <div class="flex flex-col items-center justify-center text-center p-2 pointer-events-none select-none">
      <div class="flex items-center space-x-1.5 text-xs font-semibold text-slate-500">
        <svg class="h-3.5 w-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
        </svg>
        <span>{config.label}</span>
      </div>
      <p class="text-[10px] text-slate-600 mt-0.5 hidden sm:block">{config.hint}</p>
    </div>

    <!-- 
      Adsterra script injection zone:
      The container remains exactly the same size even if the script fails or loads slowly.
    -->
    <div class="absolute inset-0 flex items-center justify-center ad-container-inner">
      <div id={`ad-holder-${slotType}`} class="w-full h-full flex items-center justify-center"></div>
      
      <script is:inline define:vars={{ slotType }}>
        (function() {
          const holderId = `ad-holder-${slotType}`;
          const holder = document.getElementById(holderId);
          if (!holder) return;

          // Adsterra slot keys (User can replace these with their actual Adsterra keys)
          const keys = {
            banner_728x90: '5ad12be0197ba0f0f5b4de4567123456',
            banner_300x250: '8fd91be0297ba0f0f5b4de4567654321',
            banner_468x60: '3cd51be0397ba0f0f5b4de4567987654'
          };

          const key = keys[slotType];
          const formats = {
            banner_728x90: { w: 728, h: 90 },
            banner_300x250: { w: 300, h: 250 },
            banner_468x60: { w: 468, h: 60 }
          };
          const fmt = formats[slotType];

          // 1. Obfuscated domains to bypass simple regex filters
          // "www.highperformanceformat.com" encoded in base64: "d3d3LmhpZ2hwZXJmb3JtYW5jZWZvcm1hdC5jb20="
          const hostB64 = "d3d3LmhpZ2hwZXJmb3JtYW5jZWZvcm1hdC5jb20=";
          const host = atob(hostB64);
          
          // "invoke.js" encoded in base64: "aW52b2tlLmpz"
          const scriptB64 = "aW52b2tlLmpz";
          const scriptName = atob(scriptB64);

          // 2. Set dynamic config options without trigger keywords in HTML markup
          const optKey = 'atOptions';
          window[optKey] = window[optKey] || {};
          window[optKey] = {
            'key': key,
            'format': 'iframe',
            'height': fmt.h,
            'width': fmt.w,
            'params': {}
          };

          // 3. Inject scripts dynamically using document.createElement to bypass parser rules
          const s = document.createElement('script');
          s.type = 'text/javascript';
          s.async = true;
          s.src = `//${host}/${key}/${scriptName}`;
          
          // Hide from typical script element scanning
          s.setAttribute('data-ab-bypass', Math.random().toString(36).substring(7));
          
          holder.appendChild(s);
        })();
      </script>
    </div>
  </div>
</div>
