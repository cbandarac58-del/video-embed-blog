---
interface Props {
  slotType: 'banner_728x90' | 'banner_300x250' | 'banner_468x60';
  className?: string;
}

const { slotType, className = "" } = Astro.props;

// Define specific styles to reserve exact space (preventing CLS)
const slotConfigs = {
  banner_728x90: {
    dimensions: "w-full max-w-[728px] h-[90px]",
    zoneId: "5938492",
  },
  banner_300x250: {
    dimensions: "w-[300px] h-[250px]",
    zoneId: "5938492",
  },
  banner_468x60: {
    dimensions: "w-full max-w-[468px] h-[60px]",
    zoneId: "5938504",
  },
};

const config = slotConfigs[slotType];
---

<div class={`flex flex-col items-center justify-center my-4 mx-auto ${className}`}>
  <!-- Label indicating sponsored content -->
  <span class="text-[9px] uppercase tracking-widest text-slate-700 mb-1">Sponsored</span>
  
  <!-- CLS-free Ad Container reserves exact dimensions before ad loads -->
  <div 
    class={`relative flex items-center justify-center bg-slate-950 rounded overflow-hidden ${config.dimensions}`}
  >
    <!-- Skeleton pulse while ad loads -->
    <div class="absolute inset-0 bg-slate-900/30 animate-pulse -z-10"></div>

    <!-- ExoClick Banner Zone -->
    <ins class="eas6a97888e2" data-zoneid={config.zoneId}></ins>
    <script>(AdProvider = window.AdProvider || []).push({"serve": {}});</script>
  </div>
</div>
